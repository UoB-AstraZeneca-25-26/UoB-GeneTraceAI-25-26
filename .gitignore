# ── Large data files ────────────────────────────────────────────
# all raw source files
data/
# all generated outputs
outputs/

# ── DuckDB catalog ───────────────────────────────────────────────
# rebuilt from the parquet files on demand — never a source of truth
*.duckdb
*.duckdb.wal

# ── Parquet files ────────────────────────────────────────────────
*.parquet
!reference/*.parquet
!cleaned_track_data/*.parquet

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.env
.venv
env/
venv/
data/
outputs/

# ── Jupyter ──────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── OS / editor ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp

# ── Claude Code ──────────────────────────────────────────────────
.claude/settings.local.json

# ── What IS tracked ─────────────────────────────────────────────
# src/           → all notebooks and scripts
# outputs/clean_data_report.xlsx  → quality report (small)
# README.md, requirements.txt, .gitignore
