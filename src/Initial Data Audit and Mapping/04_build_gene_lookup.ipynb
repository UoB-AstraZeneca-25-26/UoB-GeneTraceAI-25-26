    "# Attach additional HGNC fields before column selection\n",
    "HGNC_EXTRA = {\n",
    "    \"Approved name\": \"approved_name\",\n",
    "    \"uniprot_ids\":   \"uniprot_ids\",\n",
    "    \"entrez_id\":     \"entrez_id\",\n",
    "    \"Status\":        \"hgnc_status\",\n",
    "    \"Location\":      \"chromosomal_location\",\n",
    "}\n",
    "\n",
    "hgnc_extra_cols = {k: v for k, v in HGNC_EXTRA.items() if k in hgnc.columns}\n",
    "skipped_extra   = [k for k in HGNC_EXTRA if k not in hgnc.columns]\n",
    "print(f\"Attaching: {list(hgnc_extra_cols.values())}\")\n",
    "if skipped_extra:\n",
    "    print(f\"Skipped (not in file): {skipped_extra}\")\n",
    "\n",
    "hgnc_attach = hgnc[[\"Ensembl gene ID\"] + list(hgnc_extra_cols.keys())].copy()\n",
    "hgnc_attach = hgnc_attach.rename(\n",
    "    columns={**{\"Ensembl gene ID\": \"ensg_id\"}, **hgnc_extra_cols}\n",
    ")\n",
    "\n",
    "gene_lookup = gene_lookup.merge(hgnc_attach, on=\"ensg_id\", how=\"left\")\n",
    "print(f\"After attach: {gene_lookup.shape}\")\n",
    "print(f\"  uniprot_ids non-null : \"\n",
    "      f\"{gene_lookup['uniprot_ids'].notna().sum() if 'uniprot_ids' in gene_lookup.columns else 'SKIPPED'}\")\n",
    "print(f\"  entrez_id non-null   : \"\n",
    "      f\"{gene_lookup['entrez_id'].notna().sum() if 'entrez_id' in gene_lookup.columns else 'SKIPPED'}\")"
