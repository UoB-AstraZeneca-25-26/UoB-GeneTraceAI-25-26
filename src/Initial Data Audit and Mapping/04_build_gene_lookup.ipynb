    "# Build shared symbol -> ensg_id resolver\n",
    "# Any track needing to resolve a symbol (HGNC current, previous, or alias)\n",
    "# to a canonical ENSG ID should import this dict rather than building its own.\n",
    "import json as _json\n",
    "\n",
    "symbol_to_ensg: dict = {}\n",
    "resolver_collisions: list = []\n",
    "\n",
    "for _, row in gene_lookup.iterrows():\n",
    "    ensg = row[\"ensg_id\"]\n",
    "    candidates = [row[\"hgnc_symbol\"]]\n",
    "    for col in [\"prev_symbols\", \"alias_symbols\"]:\n",
    "        if pd.notna(row.get(col)):\n",
    "            candidates += str(row[col]).split(\"|\")\n",
    "\n",
    "    for sym in candidates:\n",
    "        sym = sym.strip()\n",
    "        if not sym:\n",
    "            continue\n",
    "        if sym in symbol_to_ensg and symbol_to_ensg[sym] != ensg:\n",
    "            resolver_collisions.append((sym, symbol_to_ensg[sym], ensg))\n",
    "        else:\n",
    "            symbol_to_ensg[sym] = ensg\n",
    "\n",
    "print(f\"Symbol resolver entries : {len(symbol_to_ensg):,}\")\n",
    "print(f\"Symbol collisions found : {len(resolver_collisions)}\")\n",
    "if resolver_collisions:\n",
    "    print(\"Collision sample (sym, existing_ensg, new_ensg):\")\n",
    "    for item in resolver_collisions[:10]:\n",
    "        print(f\"  {item}\")\n",
    "\n",
    "resolver_path = os.path.join(REF, \"gene_symbol_resolver.json\")\n",
    "with open(resolver_path, \"w\") as f:\n",
    "    _json.dump(symbol_to_ensg, f)\n",
    "print(f\"Written: {resolver_path}\")"
   ]
  },
