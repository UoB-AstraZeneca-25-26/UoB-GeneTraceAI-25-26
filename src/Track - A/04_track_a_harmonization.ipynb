  {
   "cell_type": "markdown",
   "id": "5aeaf6b3",
   "metadata": {},
   "source": [
    "### Track A: Cell Line Lookup Integration\n",
    "\n",
    "- Architecture: hub-and-spoke.\n",
    "    - Anchor  = sample_info            (owns canonical model_id, PK never null/dup)\n",
    "    - Spoke 1 = cellosaurus            (resolved via 5-step cascade, NOT direct join)\n",
    "    - Spoke 2 = depmap_profiles        (already ACH-keyed, direct left join bridge table for)\n",
    "\n",
    "- Set theory per step:\n",
    "    resolved_i   = unmatched_i * candidate_source_i\n",
    "    unmatched_{i+1} = unmatched_i \\\\ resolved_i          (strictly shrinking, first-match-wins)\n",
    "\n",
    "- Inputs expected in scope:\n",
    "    df_sample_info_cleaned, df_cellosaurus_clean, df_depmap_profiles_cleaned_pivoted\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "bc0db378",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "cell_line_lookup = pd.read_parquet(os.path.join(REF, \"cell_line_lookup.parquet\"))\n",
    "\n",
    "cell_line_lookup[\"_resolution_step\"] = pd.NA\n",
    "cell_line_lookup.loc[cell_line_lookup[\"cvcl_accession\"].notna(), \"_resolution_step\"] = \"shipped_reference\"\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "91d5446e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# unmatched_0 = all of cell_line_lookup (cvcl_accession is NA for every row)\n",
    "ces = df_cellosaurus_clean.copy()\n",
    "# Normalize case up front - rrid/accession casing is inconsistent at source\n",
    "\n",
    "ces[\"cellosaurus_accession\"] = ces[\"cellosaurus_accession\"].astype(str).str.strip().str.upper()\n",
    "\n",
    "def _normalize_cvcl(series: pd.Series) -> pd.Series:\n",
    "    \"\"\"Extract CVCL_XXXXXXX pattern from RRID/accession strings for robust matching.\"\"\"\n",
    "    return series.astype(str).str.upper().str.extract(r\"(CVCL_\\d+)\", expand=False)\n",
    "\n",
    "def _strip_name(series: pd.Series) -> pd.Series:\n",
    "    return series.astype(str).str.upper().str.replace(r\"[-_\\s]\", \"\", regex=True)\n",
    "\n",
    "cell_line_lookup[\"_rrid_cvcl\"] = _normalize_cvcl(cell_line_lookup[\"rrid\"])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "73784cca",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "# ---- Step 2a: Sanger xref match (primary - highest-recall single method) ----\n",
    "unmatched = cell_line_lookup[\"cvcl_accession\"].isna()\n",
    "sanger_lookup = ces.dropna(subset=[\"sanger_xref\"]).drop_duplicates(\"sanger_xref\")\n",
    "sanger_map = sanger_lookup.set_index(\"sanger_xref\")[[\"cellosaurus_accession\", \"synonyms\"]].to_dict(\"index\")\n",
    "\n",
    "merged = df_sample_info_cleaned.set_index(\"depmap_id\")[\"sanger_model_id\"].reindex(\n",
    "    cell_line_lookup.loc[unmatched, \"model_id\"]\n",
    ").map(sanger_map)\n",
    "merged.index = cell_line_lookup.loc[unmatched].index\n",
    "resolved_mask = unmatched & merged.notna()\n",
    "cell_line_lookup.loc[resolved_mask, \"cvcl_accession\"] = merged[merged.notna()].apply(lambda d: d[\"cellosaurus_accession\"])\n",
    "cell_line_lookup.loc[resolved_mask, \"synonyms\"] = merged[merged.notna()].apply(lambda d: d[\"synonyms\"])\n",
    "cell_line_lookup.loc[resolved_mask, \"_resolution_step\"] = \"sanger_xref\"\n",
    "\n",
    "# ---- Step 2b: direct RRID match ----------------------------------------\n",
    "unmatched = cell_line_lookup[\"cvcl_accession\"].isna()\n",
    "lookup = ces.dropna(subset=[\"cellosaurus_accession\"]).drop_duplicates(\"cellosaurus_accession\")\n",
    "merged = cell_line_lookup.loc[unmatched, \"_rrid_cvcl\"].map(\n",
    "    lookup.set_index(\"cellosaurus_accession\", drop=False)[[\"cellosaurus_accession\", \"synonyms\"]].to_dict(\"index\")\n",
    ")\n",
    "resolved_mask = unmatched & merged.notna()\n",
    "cell_line_lookup.loc[resolved_mask, \"cvcl_accession\"] = merged[merged.notna()].apply(lambda d: d[\"cellosaurus_accession\"])\n",
    "cell_line_lookup.loc[resolved_mask, \"synonyms\"] = merged[merged.notna()].apply(lambda d: d[\"synonyms\"])\n",
    "cell_line_lookup.loc[resolved_mask, \"_resolution_step\"] = \"direct_rrid\"\n",
    "\n",
    "# ---- Step 2c: secondary accession match --------------------------------\n",
    "# Real delimiter is \" || \" (double pipe, optional spacing) - confirmed in the\n",
    "# diagnostic exploration above (cell that debugged CVCL_X507 / CVCL_V618).\n",
    "# The original cascade split on a single \"|\", which never matched anything\n",
    "# and silently produced zero recoveries at this step.\n",
    "unmatched = cell_line_lookup[\"cvcl_accession\"].isna()\n",
    "sec = ces[[\"cellosaurus_accession\", \"secondary accession number(s)\", \"synonyms\"]].copy()\n",
    "sec[\"secondary accession number(s)\"] = sec[\"secondary accession number(s)\"].astype(str).str.split(r\"\\s*\\|\\|\\s*\", regex=True)\n",
    "sec = sec.explode(\"secondary accession number(s)\")\n",
    "sec[\"secondary accession number(s)\"] = sec[\"secondary accession number(s)\"].str.strip().str.upper()\n",
    "sec = sec.dropna(subset=[\"secondary accession number(s)\"]).drop_duplicates(\"secondary accession number(s)\")  # first match wins\n",
    "sec_map = sec.set_index(\"secondary accession number(s)\")[[\"cellosaurus_accession\", \"synonyms\"]].to_dict(\"index\")\n",
    "\n",
    "merged = cell_line_lookup.loc[unmatched, \"_rrid_cvcl\"].map(sec_map)\n",
    "resolved_mask = unmatched & merged.notna()\n",
    "cell_line_lookup.loc[resolved_mask, \"cvcl_accession\"] = merged[merged.notna()].apply(lambda d: d[\"cellosaurus_accession\"])\n",
    "cell_line_lookup.loc[resolved_mask, \"synonyms\"] = merged[merged.notna()].apply(lambda d: d[\"synonyms\"])\n",
    "cell_line_lookup.loc[resolved_mask, \"_resolution_step\"] = \"secondary_accession\"\n",
    "\n",
    "# ---- Step 2d: name match (exact, then stripped) ------------------------\n",
    "unmatched = cell_line_lookup[\"cvcl_accession\"].isna()\n",
    "name_lookup = ces.dropna(subset=[\"cellosaurus_cell_line_name\"]).drop_duplicates(\"cellosaurus_cell_line_name\")\n",
    "name_map = name_lookup.set_index(\"cellosaurus_cell_line_name\")[[\"cellosaurus_accession\", \"synonyms\"]].to_dict(\"index\")\n",
    "\n",
    "merged = cell_line_lookup.loc[unmatched, \"cell_line_name\"].map(name_map)\n",
    "resolved_mask = unmatched & merged.notna()\n",
    "cell_line_lookup.loc[resolved_mask, \"cvcl_accession\"] = merged[merged.notna()].apply(lambda d: d[\"cellosaurus_accession\"])\n",
    "cell_line_lookup.loc[resolved_mask, \"synonyms\"] = merged[merged.notna()].apply(lambda d: d[\"synonyms\"])\n",
    "cell_line_lookup.loc[resolved_mask, \"_resolution_step\"] = \"name_match\"\n",
    "\n",
    "unmatched = cell_line_lookup[\"cvcl_accession\"].isna()\n",
    "name_lookup[\"_stripped_name\"] = _strip_name(name_lookup[\"cellosaurus_cell_line_name\"])\n",
    "name_lookup_stripped = name_lookup.drop_duplicates(\"_stripped_name\")\n",
    "stripped_map = name_lookup_stripped.set_index(\"_stripped_name\")[[\"cellosaurus_accession\", \"synonyms\"]].to_dict(\"index\")\n",
    "\n",
    "merged = _strip_name(cell_line_lookup.loc[unmatched, \"stripped_cell_line_name\"]).map(stripped_map)\n",
    "resolved_mask = unmatched & merged.notna()\n",
    "cell_line_lookup.loc[resolved_mask, \"cvcl_accession\"] = merged[merged.notna()].apply(lambda d: d[\"cellosaurus_accession\"])\n",
    "cell_line_lookup.loc[resolved_mask, \"synonyms\"] = merged[merged.notna()].apply(lambda d: d[\"synonyms\"])\n",
    "cell_line_lookup.loc[resolved_mask, \"_resolution_step\"] = \"stripped_name_match\"\n",
    "\n",
    "# ---- Step 2e: synonym fallback (exploded, first match wins) ------------\n",
    "unmatched = cell_line_lookup[\"cvcl_accession\"].isna()\n",
    "syn = ces[[\"cellosaurus_accession\", \"synonyms\"]].copy()\n",
    "syn[\"synonyms_exploded\"] = syn[\"synonyms\"].astype(str).str.split(\"|\")\n",
    "syn = syn.explode(\"synonyms_exploded\")\n",
    "syn[\"synonyms_exploded\"] = syn[\"synonyms_exploded\"].str.strip()\n",
    "syn = syn.dropna(subset=[\"synonyms_exploded\"]).drop_duplicates(\"synonyms_exploded\")\n",
    "syn_map = syn.set_index(\"synonyms_exploded\")[[\"cellosaurus_accession\", \"synonyms\"]].to_dict(\"index\")\n",
    "\n",
    "merged = cell_line_lookup.loc[unmatched, \"cell_line_name\"].map(syn_map)\n",
    "resolved_mask = unmatched & merged.notna()\n",
    "cell_line_lookup.loc[resolved_mask, \"cvcl_accession\"] = merged[merged.notna()].apply(lambda d: d[\"cellosaurus_accession\"])\n",
    "cell_line_lookup.loc[resolved_mask, \"synonyms\"] = merged[merged.notna()].apply(lambda d: d[\"synonyms\"])\n",
    "cell_line_lookup.loc[resolved_mask, \"_resolution_step\"] = \"synonym_fallback\"\n",
    "\n",
    "cell_line_lookup.drop(columns=[\"_rrid_cvcl\"], inplace=True)\n",
    "\n",
    "# ---- Unmapped log - cellosaurus side ------------------------------------\n",
    "unmapped_cellosaurus = cell_line_lookup.loc[\n",
    "    cell_line_lookup[\"cvcl_accession\"].isna(), [\"model_id\"]\n",
    "].copy()\n",
    "unmapped_cellosaurus[\"dataset\"] = \"cellosaurus\"\n",
    "unmapped_cellosaurus[\"resolution_step_reached\"] = \"cascade_exhausted\"\n",
    "unmapped_cellosaurus[\"reason\"] = \"no match at RRID / secondary accession / name / synonym / sanger_xref\"\n",
    "unmapped_cellosaurus = unmapped_cellosaurus.rename(columns={\"model_id\": \"original_value\"})[\n",
    "    [\"original_value\", \"dataset\", \"resolution_step_reached\", \"reason\"]\n",
    "]\n"
   ]
  },
