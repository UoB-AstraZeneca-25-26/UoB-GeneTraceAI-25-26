    "# Parse cosmic & cell_model_passport from cellosaurus cross-references\n",
    "def extract_xref(ref_str, source):\n",
    "    if pd.isna(ref_str): return None\n",
    "    for entry in ref_str.split(\"||\"):\n",
    "        if source in entry.lower() and \";\" in entry:\n",
