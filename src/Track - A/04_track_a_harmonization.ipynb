    "# Cross-references format: \"source; id || source; id\"\n",
    "def parse_cross_refs(ref_str):\n",
    "    if pd.isna(ref_str): return {}\n",
    "    pairs = {}\n",
    "    for entry in ref_str.split(\"||\"):\n",
    "        if \";\" in entry:\n",
    "            source, id_ = entry.split(\";\", 1)\n",
    "            pairs[source.strip().lower()] = id_.strip()\n",
    "    return pairs\n",
    "\n",
    "df_cellosaurus_clean[\"refs_parsed\"] = df_cellosaurus_clean[\"cross-references\"].apply(parse_cross_refs)\n",
    "\n",
    "# Check all available source keys (look for depmap, cosmic, ccle)\n",
    "all_sources = set()\n",
    "df_cellosaurus_clean[\"refs_parsed\"].apply(lambda d: all_sources.update(d.keys()))\n",
    "print(sorted(all_sources)) \n",
    "\n",
    "# Extract depmap ACH IDs from cellosaurus cross-references\n",
    "def extract_depmap(ref_str):\n",
    "    if pd.isna(ref_str): return None\n",
    "    for entry in ref_str.split(\"||\"):\n",
    "        if \"depmap\" in entry.lower() and \";\" in entry:\n",
    "            return entry.split(\";\", 1)[1].strip().lower()\n",
    "    return None\n",
    "\n",
    "df_cellosaurus_clean[\"depmap_xref\"] = df_cellosaurus_clean[\"cross-references\"].apply(extract_depmap)\n",
    "\n",
    "print(\"Cellosaurus rows with depmap xref:\", df_cellosaurus_clean[\"depmap_xref\"].notna().sum())\n",
    "\n",
    "# Direct bridge: cellosaurus → depmap_profiles (bypass sample_info gap)\n",
    "bridge = df_cellosaurus_clean[[\"cellosaurus_accession\", \"depmap_xref\"]].dropna()\n",
    "recovered_depmap = bridge[bridge[\"depmap_xref\"].isin(\n",
    "    df_depmap_profiles_cleaned_pivoted[\"modelid\"].str.lower()\n",
    ")]\n",
    "print(\"Cellosaurus → depmap_profiles direct match:\", len(recovered_depmap))"
   ]
